#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

readonly DEFAULT_DATABASE_URL='postgres://postgres:postgres@127.0.0.1:5432/featherbase'
export DATABASE_URL="${DATABASE_URL:-$DEFAULT_DATABASE_URL}"

if ! PGCONNECT_TIMEOUT=2 psql "$DATABASE_URL" -tAc 'select 1' >/dev/null 2>&1; then
  if [[ "$DATABASE_URL" == "$DEFAULT_DATABASE_URL" ]] && command -v pg_ctlcluster >/dev/null 2>&1; then
    cluster="$(pg_lsclusters -h | awk 'NR == 1 { print $1, $2 }')"
    if [[ -n "$cluster" ]]; then
      read -r pg_version pg_name <<<"$cluster"
      sudo pg_ctlcluster "$pg_version" "$pg_name" start
    fi
  fi
fi

PGCONNECT_TIMEOUT=2 psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -tAc 'select 1' >/dev/null
echo 'Orb resume check complete'
