    "suite:list": "playwright test --config suite/playwright.config.mjs --list"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.3",
    "@axe-core/playwright": "^4.13.0",
    "@fission-ai/openspec": "1.13.2",
    "@playwright/test": "^1.63.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pg": "^8.23.0"
  }
}
