{
  "name": "featherbase",
  "private": true,
  "scripts": {
    "apps:prepare": "npm ci --prefix runtime-apps/tasker --ignore-scripts && npm run build --prefix runtime-apps/tasker",
    "apps:prove": "node tools/prove-runtime-packages.mjs",
    "seed:tasker": "node tools/seed-tasker-development.mjs",
    "check:evidence": "node --test tools/*.test.mjs && node tools/check-evidence.mjs",
    "manual:build": "node tools/build-manual.mjs",
    "manual:fixtures": "node docs/manual/fixtures/make-fixtures.mjs",
    "smoke": "pnpm --filter server test:smoke && pnpm --filter web smoke",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:all": "pnpm -r test && pnpm --filter web e2e"
  },
  "packageManager": "pnpm@10.33.0"
}
