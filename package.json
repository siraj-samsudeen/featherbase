{
  "name": "featherbase",
  "private": true,
  "scripts": {
    "apps:prepare": "npm ci --prefix runtime-apps/tasker --ignore-scripts && npm test --prefix runtime-apps/tasker && npm run build --prefix runtime-apps/tasker && npm run build --prefix runtime-apps/scope-proof",
    "apps:prove": "node tools/prove-runtime-packages.mjs",
    "seed:tasker": "node tools/seed-tasker-development.mjs",
    "check:openspec:specs": "openspec validate --specs --strict --no-interactive",
    "check:openspec:changes": "openspec validate --changes --strict --no-interactive",
    "check:specs": "pnpm check:openspec:specs && pnpm check:openspec:changes && pnpm check:unarchived-changes",
    "check:unarchived-changes": "node --test tools/check-unarchived-changes.test.mjs && node tools/check-unarchived-changes.mjs",
    "check:e2e-dsl": "node --test tools/check-e2e-dsl.test.mjs && node tools/check-e2e-dsl.mjs",
    "check:sensitive": "node --test tools/check-sensitive.test.mjs && node tools/check-sensitive.mjs",
    "check:vocabulary": "node --test tools/check-vocabulary.test.mjs && node tools/check-vocabulary.mjs",
    "smoke": "pnpm --filter server test:smoke && pnpm --filter web smoke",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:all": "pnpm -r test && pnpm --filter web e2e"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@fission-ai/openspec": "1.13.2"
  }
}
