    { "name": "site", "label": "Site", "type": "Link", "to": "masters.site", "required": true },
    { "name": "reports_to", "label": "Reports to", "type": "Link", "to": "masters.person" },
    { "name": "starts_on", "label": "Starts on", "type": "Date", "required": true },
    { "name": "ends_on", "label": "Ends on", "type": "Date" }
