{
  "cwd": "../candidate-checkout",
  "commands": {
    "install": ["REPLACE_WITH_DOCUMENTED_INSTALL"],
    "build": ["REPLACE_WITH_DOCUMENTED_PRODUCTION_BUILD"],
    "check": ["REPLACE_WITH_DOCUMENTED_STATIC_CHECK"],
    "test": ["REPLACE_WITH_DOCUMENTED_CANDIDATE_TESTS"],
    "migrate": ["REPLACE_WITH_DOCUMENTED_MIGRATE"],
    "start": ["REPLACE_WITH_DOCUMENTED_PRODUCTION_START"]
  },
  "readiness": "/ready",
  "migrationHistoryQuery": "SELECT version FROM REPLACE_WITH_DOCUMENTED_LEDGER ORDER BY version",
  "http": {
    "openapi": "/openapi.json",
    "filters": { "all": "all", "open": "open", "completed": "completed" },
    "operations": {
      "list": { "method": "GET", "path": "/todos", "query": { "filter": "$filter" } },
      "read": { "method": "GET", "path": "/todos/{id}" },
      "create": { "method": "POST", "path": "/todos", "body": { "title": "$title" } },
      "rename": { "method": "PATCH", "path": "/todos/{id}", "body": { "title": "$title", "version": "$proof" } },
      "complete": { "method": "PATCH", "path": "/todos/{id}", "body": { "completed": "$completed", "version": "$proof" } },
      "delete": { "method": "DELETE", "path": "/todos/{id}", "body": { "version": "$proof" } }
    },
    "fields": { "list": "/items", "record": "", "id": "/id", "title": "/title", "completed": "/completed", "proof": "/version", "error": "/code" },
    "errors": {
      "invalid": { "statuses": [400, 422, 428], "codes": ["invalid_input", "missing_version"] },
      "conflict": { "statuses": [409, 412], "codes": ["conflict"] },
      "missing": { "statuses": [404, 410], "codes": ["not_found"] }
    }
  }
}
