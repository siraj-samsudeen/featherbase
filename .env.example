# Copy to .env.local (gitignored). Everything here is optional; a real
# environment variable wins over a line in .env.local. Used by `featherbase`
# and `pnpm dev`. Setup/start/health all select the same database.

# A local Postgres. Default: postgres://postgres:postgres@127.0.0.1:5432/featherbase
# Explicit named instances default instead to fb_<client>_<instance>.
DATABASE_URL=
API_PORT=
WEB_PORT=

# Optional Feather Dash named-instance settings, not needed by Featherbase.
# Read when dev or prod settings are applied (--environment dev). Local needs none.
DIVE_ID=
SERVICE_ACCOUNT=

# Only to reach the warehouse from your machine. --made-up-data needs neither.
MOTHERDUCK_URL=
MOTHERDUCK_TOKEN=
