# Copy to .env.local (gitignored). Everything here is optional; a real
# environment variable wins over a line in .env.local. Used by `pnpm dev`.

# A local Postgres. Default: postgres://postgres:postgres@127.0.0.1:5432/fb_<client>_<instance>
DATABASE_URL=
API_PORT=
WEB_PORT=

# Read when dev or prod settings are applied (--environment dev). Local needs none.
DIVE_ID=
DIVE_VERSION=
SERVICE_ACCOUNT=

# Only to reach the warehouse from your machine. --made-up-data needs neither.
MOTHERDUCK_URL=
MOTHERDUCK_TOKEN=
