{
  // Storybook's stories (#1070), here and beside the shared kit's components.
  // The kit does not depend on Storybook itself, so its stories find
  // Storybook's packages through this app's.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "paths": {
      "storybook/*": ["./node_modules/storybook/dist/*"],
      "@storybook/react-vite": ["./node_modules/@storybook/react-vite/dist/index.d.ts"]
    }
  },
  "include": ["src", "stories", ".storybook", "../../packages/shop-floor/src/**/*.stories.tsx"]
}
