{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:e2e": "VITE_COVERAGE=true npm --prefix ../../example-apps/tasker run build && E2E_ISOLATED=1 E2E_COVERAGE=1 playwright test",
    "coverage:merged": "node --test scripts/coverage-merge.test.mjs && node scripts/coverage-merge.mjs && nyc report --temp-dir .coverage --reporter=text-summary --reporter=json-summary --reporter=html --report-dir coverage-merged",
    "smoke": "playwright test e2e/smoke.spec.ts",
    "e2e": "E2E_ISOLATED=1 playwright test",
    "e2e:served": "playwright test --config playwright.served.config.ts",
    "tour": "playwright test --config playwright.tours.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.stories.json --noEmit"
  },
  "dependencies": {
    "@featherbase/shop-floor": "workspace:*",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "lucide-react": "1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shared": "workspace:*",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-mcp": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "@vitest/istanbul-lib-coverage": "2.1.0",
    "@vitest/istanbul-lib-source-maps": "2.1.0",
    "feather-testing-core": "0.6.0",
    "feather-testing-postgres": "0.3.0",
    "jsdom": "^30.1.3",
    "msw": "3.0.4",
    "msw-storybook-addon": "3.0.3",
    "nyc": "18.0.0",
    "postgres": "^4.0.0",
    "server": "workspace:*",
    "storybook": "10.6.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "^5.0.5"
  }
}
