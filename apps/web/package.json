{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "playwright test e2e/smoke.spec.ts",
    "e2e": "E2E_ISOLATED=1 playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.97.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shared": "workspace:*",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "feather-testing-core": "^0.2.0",
    "feather-testing-postgres": "git+https://github.com/siraj-samsudeen/feather-testing-postgres.git#59b7b84",
    "jsdom": "^26.0.0",
    "postgres": "^3.4.5",
    "server": "workspace:*",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
