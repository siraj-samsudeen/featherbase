# Every variable the Featherbase server reads. Generated from
# apps/server/src/env.ts by `pnpm --filter server generate:env`; do not edit.
# Copy to apps/server/.env for a checkout (loaded at boot, never overriding the
# shell), or set them in the host's variables. Every line is commented out: an
# empty value counts as missing. Never commit a secret.

# which environment this process is: production, staging, development or test; it wins over NODE_ENV. The release (and cli boot-check) refuses when neither is set (#430). Only development and test allow zero-setup Administrator credentials
# required: yes, this or NODE_ENV, for a release · default: NODE_ENV, then development
# FEATHERBASE_ENV=

# read only when FEATHERBASE_ENV is unset (Vitest sets it to test)
# required: no · default: development
# NODE_ENV=

# Postgres connection string. db.ts sets prepare: false, which transaction-mode poolers (such as Supabase on port 6543) require
# required: yes, outside development and test · SECRET · default: local featherbase (featherbase_test under test)
# DATABASE_URL=

# HTTP and WebSocket port
# required: no · default: 8000
# PORT=

# comma-separated CORS allowlist; needed only when the SPA is served from another origin
# required: no · default: http://localhost:5173,http://127.0.0.1:5173
# WEB_ORIGINS=

# a JSON array saying what each web address of this instance opens (admin or an app) and which one emailed links use. See Instance addresses. Unset (development and test only), the server falls back to the request, trusting the first x-forwarded-proto hop
# required: yes, outside development and test
# INSTANCE_ADDRESSES=

# session and token signing. Must differ between environments, or one environment's sessions are valid on another
# required: yes, outside development and test · SECRET · default: dev-secret-change-me
# JWT_SECRET=

# signs the short-lived URLs of private files
# required: no · SECRET · default: JWT_SECRET
# FILE_URL_SECRET=

# provisions a null Administrator password hash; missing or blank leaves production password login locked. Never rotates an existing hash (see Rotating credentials)
# required: no · SECRET
# ADMIN_PASSWORD=

# the Google OAuth client secret; the client id and allowed domains live on the Google sign-in method
# required: yes, while a Google sign-in method is enabled with a client id · SECRET
# GOOGLE_CLIENT_SECRET=

# uploaded-file directory; it must persist across deploys (on Railway, a Volume)
# required: recommended (warns when missing outside development and test) · default: apps/server/storage
# FILE_STORAGE_DIR=

# Chromium binary for PDF printing; unset, Playwright resolves its own. Never hardcoded
# required: no
# CHROMIUM_PATH=

# where PDF printing also looks for a Playwright-installed Chromium
# required: no · default: /opt/pw-browsers
# PLAYWRIGHT_BROWSERS_PATH=

# turns real delivery on (smtp-relay.gmail.com); unset or blank keeps the Email Sink. See Email
# required: no
# SMTP_HOST=

# 587 = STARTTLS, 465 = implicit TLS. On every port but 465, STARTTLS is required
# required: no · default: 587
# SMTP_PORT=

# a Workspace user in the domain; turns on SMTP AUTH
# required: no
# SMTP_USER=

# that user's app password; required when SMTP_USER is set. Google's grouped display (abcd efgh ijkl mnop) has its spaces removed
# required: no · SECRET
# SMTP_PASSWORD=

# the From of every SMTP message (Feather Dash <noreply@example.com>); it wins over any Email Account address. Unset, the default Email Account's address is used
# required: no
# MAIL_FROM=

# the EHLO hostname. Unset, the domain of MAIL_FROM, then the host of the INSTANCE_ADDRESSES entry marked for emails, then the sender's domain
# required: no
# SMTP_NAME=

# pre-auth fixed window, in milliseconds
# required: no · default: 900000
# PREAUTH_WINDOW_MS=

# password and delegated sign-in submissions per source and window
# required: no · default: 60
# PREAUTH_LOGIN_MAX=

# per provider, username and source
# required: no · default: 5
# PREAUTH_PASSWORD_MAX=

# OAuth initiations per source and window
# required: no · default: 30
# PREAUTH_OAUTH_LOGIN_MAX=

# OAuth callbacks per source and window
# required: no · default: 30
# PREAUTH_OAUTH_CALLBACK_MAX=

# public web-form POSTs per source and window
# required: no · default: 30
# PREAUTH_FORM_MAX=

# sign-ups per source and window
# required: no · default: 10
# PREAUTH_SIGNUP_MAX=

# steps of the hand-off between instance addresses per source and window; each hand-off takes two, apart from the Google buckets
# required: no · default: 200
# PREAUTH_HANDOFF_MAX=

# comma-separated exact socket IPs trusted to append X-Forwarded-For
# required: no
# TRUSTED_PROXY_IPS=

# per-user API rate-limit window
# required: no · default: 60000
# RATE_LIMIT_WINDOW_MS=

# per-user API requests per window, unless the person has their own limit
# required: no · default: 100000
# RATE_LIMIT_MAX=

# trust-any-password lets a linked account sign in by its employee code without a password, to try a rollout as any linked Team Leader. Any other value is ignored
# required: never in production: development, test and staging only
# DELEGATED_LOGIN_TEST_MODE=

# 1 turns on the mock Google provider, which mints a session for any typed email from a pre-auth endpoint. For development and the test suites
# required: never outside development and test
# ALLOW_MOCK_OAUTH=

# preview deployments: the one-link sign-in's secret, 32+ characters. See PREVIEW.md
# required: never in production: development, test and staging only · SECRET
# PREVIEW_LOGIN_KEY=

# preview deployments: the account the link signs in as (never Administrator)
# required: never in production: development, test and staging only
# PREVIEW_LOGIN_USER=

# preview deployments: the full name the pre-deploy step gives the preview person (default Preview Visitor)
# required: no
# PREVIEW_USER_NAME=

# 1 skips the check that the database was stamped by this environment. Break-glass only
# required: no
# DISABLE_DATABASE_ENVIRONMENT_CHECK=

# JSON array of extra app package directories to discover at boot
# required: no · default: []
# FEATHERBASE_APP_PATHS=

# background worker poll interval
# required: no · default: 500
# JOB_POLL_MS=

# the server pnpm smoke probes
# required: no · default: http://localhost:8000
# SERVER_URL=

# MotherDuck access for the sales-target embed and warehouse reads; never logged, returned or stored
# required: no · SECRET
# MOTHERDUCK_TOKEN=

# MotherDuck API base
# required: no · default: https://api.motherduck.com
# MOTHERDUCK_API_BASE=

# the embed sandbox origin; overridable only for a local stub
# required: no · default: https://embed-motherduck.com
# MOTHERDUCK_EMBED_ORIGIN=

# the sales-target Dive
# required: no
# DIVE_ID=

# the sales-target Dive version
# required: no
# DIVE_VERSION=

# the MotherDuck service account the embed runs as
# required: no
# SERVICE_ACCOUNT=

# pins "today" (YYYY-MM-DD) for the sales target; for tests and rehearsals
# required: no
# SALES_TARGET_TODAY=

# path of a local .env.local the sales-target experiment reads DIVE_ID, DIVE_VERSION and SERVICE_ACCOUNT from
# required: no
# SALES_TARGET_SHARED_ENV=
