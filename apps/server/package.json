{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "release": "tsx src/release.ts",
    "migrate": "tsx src/migrate.ts",
    "patches": "tsx src/run-patches.ts",
    "cli": "tsx src/cli.ts",
    "lint:sql": "tsx scripts/check-sql-escapes.ts",
    "reset:helpdesk": "tsx scripts/reset-helpdesk.ts",
    "seed:checklists": "tsx scripts/seed-checklists.ts",
    "seed:helpdesk": "tsx scripts/seed-helpdesk.ts",
    "verify:helpdesk": "tsx scripts/verify-helpdesk.ts",
    "test": "vitest run",
    "test:smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "e2e:reset": "tsx scripts/reset-e2e-db.ts",
    "e2e:serve": "tsx scripts/reset-e2e-db.ts && tsx src/migrate.ts && tsx src/run-patches.ts && tsx watch src/index.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "mysql2": "^3.23.3",
    "playwright": "^1.61.1",
    "postgres": "^3.4.5",
    "shared": "workspace:*",
    "tsx": "^4.19.0",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.9.0",
    "feather-testing-postgres": "git+https://github.com/siraj-samsudeen/feather-testing-postgres.git#59b7b84",
    "pdf-parse": "^2.4.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
