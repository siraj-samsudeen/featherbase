{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "release": "tsx src/release.ts",
    "pre-deploy": "tsx src/pre-deploy.ts",
    "migrate": "tsx src/migrate.ts",
    "baseline:generate": "tsx scripts/generate-baseline.ts",
    "cli": "tsx src/cli.ts",
    "lint:sql": "tsx scripts/check-sql-escapes.ts",
    "lint:env": "tsx scripts/check-env-reads.ts",
    "generate:env": "tsx scripts/generate-env-docs.ts",
    "check:env": "tsx scripts/generate-env-docs.ts --check",
    "reset:helpdesk": "tsx scripts/reset-helpdesk.ts",
    "seed:checklists": "tsx scripts/seed-checklists.ts",
    "seed:helpdesk": "tsx scripts/seed-helpdesk.ts",
    "verify:helpdesk": "tsx scripts/verify-helpdesk.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "e2e:reset": "tsx scripts/reset-e2e-db.ts",
    "e2e:serve": "tsx scripts/reset-e2e-db.ts && tsx src/migrate.ts && tsx watch src/index.ts",
    "seed:sales-target": "tsx scripts/seed-sales-target.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "markdown-it": "14.3.2",
    "mysql2": "^3.23.3",
    "nodemailer": "10.2.1",
    "playwright": "^1.61.1",
    "postgres": "^3.4.5",
    "shared": "workspace:*",
    "tsx": "^4.19.0",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.9.0",
    "feather-testing-postgres": "0.2.0",
    "pdf-parse": "^2.4.5",
    "smtp-server": "^3.21.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
