  "migrations": [
    {"id": "fixed_by_and_source_place", "fromVersion": "0.1.0", "toVersion": "0.1.1", "operations": [
      {"kind": "addColumn", "table": "equipment.job", "column": { "column_name": "fixed_by", "label": "Fixed by (person ID)", "column_type": "Data" }},
