{
  "name": "@jeyarama/dash",
  "version": "0.12.7",
  "private": true,
  "type": "module",
  "featherbase": "featherbase.json",
  "files": [
    "featherbase.json",
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild src/server.ts --bundle --format=esm --platform=node --outfile=dist/server.mjs",
    "dev": "npm run build:server -- --watch=forever & vite build --watch --emptyOutDir=false",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc -p tsconfig.frontend-test.json --noEmit",
    "dev:repin": "scripts/dev-repin.sh",
    "test:frontend": "../../../apps/server/node_modules/.bin/vitest run --config vitest.frontend.config.ts",
    "test:coverage:frontend": "npm run test:frontend -- --coverage",
    "test:platform": "scripts/platform-test.sh",
    "test:coverage:backend": "../../../apps/server/node_modules/.bin/vitest run --config vitest.backend.config.ts",
    "test:coverage:backend:platform": "DASH_BACKEND_COVERAGE=1 scripts/platform-test.sh",
    "coverage:backend:merged": "node scripts/merge-backend-coverage.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@featherbase/shop-floor": "file:../../../packages/shop-floor",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "@vitest/istanbul-lib-coverage": "2.1.0",
    "@vitest/istanbul-lib-instrument": "1.0.2",
    "esbuild": "^0.28.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
