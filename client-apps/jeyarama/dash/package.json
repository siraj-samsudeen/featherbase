{
  "name": "@jeyarama/feather-dash",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "featherbase": "featherbase.json",
  "files": [
    "featherbase.json",
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild src/server.ts --bundle --format=esm --platform=node --outfile=dist/server.mjs",
    "dev": "npm run build:server -- --watch=forever & vite build --watch --emptyOutDir=false",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:repin": "scripts/dev-repin.sh",
    "test:platform": "scripts/platform-test.sh",
    "compare": "node src/compare-cli.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
