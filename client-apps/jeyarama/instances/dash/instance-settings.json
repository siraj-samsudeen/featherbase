{
  "settings": {
    "System Settings": {
      "app_name": "Dash",
      "time_zone": "Asia/Kolkata",
      "privacy_notice": {
        "file": "privacy-notice.md"
      }
    },
    "Sign In Method": [
      {
        "row_id": "password",
        "kind": "password",
        "label": "Password",
        "enabled": true,
        "new_person": "refuse",
        "self_link": true
      },
      {
        "row_id": "google",
        "kind": "google_oauth",
        "label": "Google",
        "enabled": true,
        "new_person": "create_if_email_domain_allowed",
        "allowed_email_domains": "jeyarama.com",
        "self_link": false
      },
      {
        "row_id": "stylehr",
        "kind": "external_password",
        "label": "StyleHR",
        "enabled": true,
        "service_url": "https://stylehr.in/api/login/",
        "new_person": "create_if_on_roster",
        "self_link": false,
        "settings": {
          "id_field": "email",
          "password_field": "password",
          "nested_keys": ["data", "user", "employee", "result"],
          "success_keys": ["token", "access", "access_token", "key", "employee_id", "employee_key", "id"],
          "success_flags": ["success", "ok", "authenticated"],
          "error_keys": ["error", "errors"],
          "status_key": "status",
          "error_statuses": ["error", "fail", "failed", "failure", "invalid"],
          "left_date_keys": ["exit_date", "relieving_date", "date_of_relieving", "termination_date", "resignation_date", "last_working_date"],
          "inactive_flags": ["is_active", "active"],
          "left_status_keys": ["status", "employment_status", "employee_status"],
          "left_words": ["resign", "terminat", "reliev", "exit", "inactive", "left", "separated"],
          "roster": {
            "table": "Employee",
            "sign_in_id_column": "employee_code",
            "record_number_column": "employee_id_stylehr",
            "person_column": "person",
            "name_column": "name",
            "status_column": "status",
            "current_status": "Current",
            "provider_record_key": "employee_id",
            "identifiers": {
              "stylehr-employee-code": "employee_code"
            }
          }
        }
      }
    ],
    "Scheduled Job": [
      {
        "row_id": "auto_email_reports",
        "enabled": true
      },
      {
        "row_id": "check_instance_health",
        "enabled": true
      },
      {
        "row_id": "check_sla",
        "enabled": true
      },
      {
        "row_id": "refresh_datasets",
        "enabled": true
      }
    ],
    "Data Source": [
      {
        "row_id": "motherduck",
        "engine": "motherduck",
        "default_schema": "gold.main",
        "databases": [
          {
            "name": "gold"
          },
          {
            "name": "marts"
          }
        ]
      }
    ]
  },
