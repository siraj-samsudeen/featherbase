    "Sign In Method": [
      {
        "row_id": "password",
        "kind": "password",
        "label": "Password",
        "enabled": true,
        "new_person": "refuse",
        "self_link": true
      },
      {
        "row_id": "google",
        "kind": "google",
        "label": "Google",
        "enabled": true,
        "new_person": "create_if_email_domain_allowed",
