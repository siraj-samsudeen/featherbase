    {"table": "tickets.event", "role": "All", "own_rows_only": true, "can_read": true, "can_create": true},
    {"table": "tickets.event", "role": "Tickets Support", "can_read": true, "can_create": true},
    {"table": "tickets.progress", "role": "All", "can_read": true, "can_create": true},
    {"table": "tickets.member", "role": "All", "can_read": true, "can_write": true, "can_create": true},
    {"table": "tickets.ticket_type", "role": "All", "can_read": true},
    {"table": "tickets.ticket_type", "role": "System Manager", "can_read": true, "can_write": true, "can_create": true},
    {"table": "tickets.type_field", "role": "All", "can_read": true},
    {"table": "tickets.type_field", "role": "System Manager", "can_read": true, "can_write": true, "can_create": true, "can_delete": true}
  ]
