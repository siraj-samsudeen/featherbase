  "tables": [
    {"name": "tickets.ticket", "label": "Ticket", "module": "Tickets", "id_pattern": "FT-.#####", "title_column": "title", "columns": [
      {"column_name": "title", "label": "Public summary", "column_type": "Data", "reqd": true, "in_list_view": true},
      {"column_name": "owner", "label": "Requester", "column_type": "Data", "reqd": true},
