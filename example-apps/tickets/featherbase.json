      {"column_name": "by", "label": "Actor", "column_type": "Data"},
      {"column_name": "at", "label": "Time", "column_type": "Data"}
    ]},
    {"name": "tickets.ticket_type", "label": "Ticket type", "module": "Tickets", "id_pattern": "FTT-.###", "title_column": "label", "columns": [
      {"column_name": "type_key", "label": "Key (lower case, never changed)", "column_type": "Data", "reqd": true, "unique": true, "in_list_view": true},
      {"column_name": "label", "label": "Name", "column_type": "Data", "reqd": true, "in_list_view": true},
      {"column_name": "enabled", "label": "Enabled", "column_type": "Check", "default_value": "1", "in_list_view": true},
      {"column_name": "states", "label": "States (one per line; the first is where a ticket starts)", "column_type": "Text", "reqd": true},
      {"column_name": "done_states", "label": "Done states (one per line)", "column_type": "Text"},
      {"column_name": "reopen_state", "label": "State a reopened ticket returns to", "column_type": "Data"},
      {"column_name": "routing", "label": "Routing (JSON: field, table, match, person, primary)", "column_type": "Text"}
    ]},
    {"name": "tickets.type_field", "label": "Ticket type field", "module": "Tickets", "id_pattern": "FTF-.#####", "title_column": "label", "columns": [
      {"column_name": "ticket_type", "label": "Ticket type", "column_type": "Reference", "reference_table": "tickets.ticket_type", "reqd": true, "in_list_view": true},
      {"column_name": "field_name", "label": "Key", "column_type": "Data", "reqd": true, "in_list_view": true},
      {"column_name": "label", "label": "Label", "column_type": "Data", "reqd": true, "in_list_view": true},
      {"column_name": "field_type", "label": "Field type", "column_type": "Choice", "choices": "text\nlong text\nchoice\ndate\nperson\nlink", "default_value": "text", "reqd": true, "in_list_view": true},
      {"column_name": "choices", "label": "Choices (one per line)", "column_type": "Text"},
      {"column_name": "link_table", "label": "Linked Table (listed in linked_tables)", "column_type": "Data"},
      {"column_name": "link_label", "label": "Linked Table column to show", "column_type": "Data"},
      {"column_name": "required", "label": "Required", "column_type": "Check"},
      {"column_name": "field_order", "label": "Order", "column_type": "Int"}
    ]},
    {"name": "tickets.member", "label": "Tickets member", "module": "Tickets", "title_column": "full_name", "columns": [
      {"column_name": "full_name", "label": "Name", "column_type": "Data", "reqd": true}
    ]},
    {"name": "tickets.progress", "label": "Public progress", "module": "Tickets", "id_pattern": "FTP-.########", "columns": [
