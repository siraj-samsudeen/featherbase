{
  "manifestVersion": 1,
  "platformVersion": "2026-10",
  "name": "ask",
  "title": "Ask",
  "summary": "Ask about your data, your Tables and Featherbase",
  "icon": "bot",
  "server": "dist/server.mjs",
  "client": "dist/client",
  "entryTable": "ask.chat",
  "actions": {"version": 2, "tables": ["ask.chat", "ask.question"], "operations": {
    "ask": {"policy": {"kind": "table"}, "authorization": {"kind": "generic"}}
  }},
  "reads": {"version": 1, "tables": ["ask.chat"], "operations": {
    "think": {"policy": {"kind": "table"}, "authorization": {"kind": "generic"}, "outbound": true, "featherbaseMcp": true}
  }},
  "tables": [
    {"name": "ask.chat", "label": "Chat", "module": "Ask", "title_column": "title", "columns": [
      {"column_name": "title", "label": "Title", "column_type": "Data", "reqd": true, "in_list_view": true}
    ]},
    {"name": "ask.question", "label": "Question", "module": "Ask", "columns": [
      {"column_name": "chat", "label": "Chat", "column_type": "Reference", "reference_table": "ask.chat", "reqd": true, "in_list_view": true},
      {"column_name": "question", "label": "Question", "column_type": "Text", "reqd": true, "in_list_view": true},
      {"column_name": "answer", "label": "Answer", "column_type": "Text"},
      {"column_name": "answer_kind", "label": "Answer kind", "column_type": "Data"},
      {"column_name": "steps", "label": "Steps", "column_type": "JSON"}
    ]}
  ],
  "permissions": [
    {"table": "ask.chat", "role": "All", "own_rows_only": true, "can_read": true, "can_create": true},
    {"table": "ask.question", "role": "All", "own_rows_only": true, "can_read": true, "can_create": true}
  ]
}
