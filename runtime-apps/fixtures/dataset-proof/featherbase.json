{
  "manifestVersion": 1,
  "platformVersion": "2026-10",
  "name": "datasetproof",
  "title": "Dataset proof",
  "entryTable": "datasetproof.note",
  "server": "server.mjs",
  "tables": [
    {
      "name": "datasetproof.note",
      "label": "note",
      "id_pattern": "prompt",
      "columns": [{ "column_name": "body", "column_type": "Data" }]
    }
  ],
  "roles": ["Dataset Reader"],
  "permissions": [{ "table": "datasetproof.note", "role": "Dataset Reader", "can_read": true }],
  "datasets": [
    {
      "name": "sales",
      "source": "datasetproof-warehouse",
      "query": "select plant_code, section_code, business_day, amount, units, note from b4_dataset.sales",
      "columns": [
        { "name": "plant_code", "type": "text" },
        { "name": "section_code", "type": "text" },
        { "name": "business_day", "type": "date" },
        { "name": "amount", "type": "money" },
        { "name": "units", "type": "integer" },
        { "name": "note", "type": "text" }
      ],
      "keys": ["plant_code", "section_code", "business_day"],
      "filters": { "store": "plant_code", "section": "section_code" }
    },
    {
      "name": "accounts",
      "source": "datasetproof-warehouse",
      "query": "select account_id, booked_at, amount from b4_dataset.accounts",
      "columns": [
        { "name": "account_id", "type": "integer" },
        { "name": "booked_at", "type": "date" },
        { "name": "amount", "type": "money" }
      ],
      "keys": ["account_id", "booked_at"],
      "filters": { "account": "account_id" }
    },
    {
      "name": "unplugged",
      "source": "datasetproof-missing",
      "query": "select plant_code from b4_dataset.sales",
      "columns": [{ "name": "plant_code", "type": "text" }],
      "keys": ["plant_code"],
      "filters": { "store": "plant_code" }
    }
  ],
  "reads": {
    "version": 1,
    "tables": ["datasetproof.note"],
    "operations": {
      "inside": {
        "policy": { "kind": "person_scope", "readRoles": ["Dataset Reader"], "actionRoles": [] },
        "authorization": { "kind": "generic" }
      },
      "outside": {
        "policy": { "kind": "person_scope", "readRoles": ["Dataset Reader"], "actionRoles": [] },
        "authorization": { "kind": "generic" },
        "outbound": true
      },
      "unscoped": { "policy": { "kind": "table" }, "authorization": { "kind": "generic" } }
    }
  }
}
