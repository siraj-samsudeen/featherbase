{
  "name": "@featherbase-learning/tasker",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "featherbase": "featherbase.json",
  "files": [
    "featherbase.json",
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && esbuild src/server.ts --bundle --format=esm --platform=node --sourcemap --outfile=dist/server.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.5",
    "vite-plugin-istanbul": "7.2.1",
    "vitest": "^4.1.12"
  }
}
